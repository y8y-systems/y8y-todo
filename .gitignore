# y8y todolist · monorepo · handoff .gitignore
#
# 此 .gitignore 来自生产项目,Step-5 Mac dev 接手后可能进一步收紧。
# 重点: **未来 git add . 不会把以下误纳入** —— 即使本地数据家被软链 / 拷贝到工程目录。
# ───────────────────────────────────────────────────────────

# ── 任务数据 (绝对不能进 git) ──
*.md
!README.md
!README-LEGACY.md
!SOURCE_HANDOFF.md
!THIRD_PARTY_LICENSES.md
!BRANDING.md
!docs/*.md
# AGENTS.md = 开发 Agent 的规范入口 (硬性规则 + 文档地图)。
# 它是项目文档, 不是任务数据 —— 必须入库, 否则所有 agent 拿不到开发契约。
!AGENTS.md

# ── 旧位置备份目录 ──
_backup_*/
.backup_*/
backup/

# ── Playwright 验证产物 ──
_verify/
*.png
!vendor/y8y-shared-chrome/icons/ui/*.png
!vendor/y8y-shared-chrome/fonts/*.woff2
# 官方品牌 Logo 是正式发行资产 (品牌素材许可, 非 MIT), 必须入库 ——
# README/Header/favicon 都引用它; 与 Playwright 截图产物有本质区别。
# 含矢量主文件 y8y-logo.svg (19×19 像素网格) 与各显示尺寸衍生版
# (500 主图 / 33 Header / 250 README / 48 favicon) —— 衍生版全部由
# scripts/regen-brand-assets.py 从主文件生成 (最近邻硬边缩放),
# 不允许浏览器端非整数缩放把像素块打散。
!vendor/y8y-shared-chrome/brand/*.png
!vendor/y8y-shared-chrome/brand/*.svg

# 字体迁移的对照截图是 PR 评审材料 (docs/font-migration/README.md 里引用),
# 与 Playwright 的一次性验证产物不同 —— 入库以便 review 时直接看图。
!docs/font-migration/*.md
!docs/font-migration/*.png

# logo 替换的对照图同理 (docs/brand/README.md 里引用) —— 品牌评审材料。
!docs/brand/*.md
!docs/brand/*.png

# ── Python 运行时 ──
__pycache__/
*.pyc
*.pyo

# ── 编辑器 / 系统 ──
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── 环境 / 日志 ──
.env
.env.local
*.log
logs/

# ── 真实 OAuth / Token 文件(永远不能进 git)──
google_calendar/client_secret.json
google_calendar/tokens.json
google_calendar/oauth_states.json
google_calendar/settings.json
internal_tokens.json
persistent_projects.json

# ── 数据家(开发用本地目录)──
data/
/data
# dev 模式默认数据目录 (config.default_data_dir: ./dev-data) —
# 任务文件虽被 *.md 挡住, 但 lists/*/meta.json 等非 .md 状态文件会漏过,
# 必须整目录忽略 (开源审计: 首次部署/本地开发都不得把数据带进 git)。
dev-data/
/dev-data

# ── 私人配置 / 临时笔记 ──
*.bak
*.bak-*
*.head
*.tar.gz
*.tgz
_snapshots*/

# ── 测试临时目录 (pytest basetemp; PR #5 事故复盘) ──
# 2026-10 事故: 本地以 --basetemp=.pr 跑测试, `git add .` 把 116 个
# 临时文件误提交进 PR #5。CI 固定用 .pytest-tmp (见 .github/workflows),
# 这里覆盖全部常见 basetemp 变体 + pytest 缓存/输出, 任何名字都不会
# 再进版本库。
.pytest-tmp/
.pytest_cache/
.pr/
.pytest-*/
pytest-output.txt

# ── CI 本地虚拟环境 (browser-e2e) ──
.venv/

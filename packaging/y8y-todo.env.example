# y8y-todo 环境变量示例 (复制到 /etc/y8y-todo/y8y-todo.env, 权限 600)
#
# 所有值都是占位示例 —— 换成你自己的。这个文件含身份配置, 不要提交
# 进 git, 不要放在 Web 根目录。

# ── 数据目录 (任务/列表都存这里, 提前创建并属于 y8y 用户) ──
Y8Y_DATA_DIR=/var/lib/y8y-todo

# ── 监听 (保持回环 + 反代; 仅当你知道自己在做什么时才改 0.0.0.0) ──
Y8Y_BIND=127.0.0.1
Y8Y_PORT=8086

# ── 用户 (邮箱=本地身份, 逗号分隔; 邮箱由你的反向代理注入并校验) ──
Y8Y_USERS=alice@example.com=alice,bob@example.com=bob

# ── 受信代理 (只有这些地址传来的身份 header 才被采信) ──
Y8Y_TRUSTED_PROXIES=127.0.0.1

# ── 对外 URL (信息展示用; Google Calendar 集成已移除, 不再需要回调) ──
Y8Y_PUBLIC_URL=https://todo.example.com

# ── 时区 (IANA 名称) ──
Y8Y_TIMEZONE=Asia/Tokyo

# y8y-todo 通知凭据示例 (复制到 /etc/y8y-todo/y8y-todo-notify.env, 权限 600)
#
# ⚠️ 这个文件**只有通知调度器读** (y8y-todo-notify.service)。
#    y8y-todo.service (Web 服务) 不读它 —— Web 进程拿不到任何第三方凭据。
#
# ⚠️ 里面的值是**真凭据**, 不要提交进 git, 不要放进 Web 根目录,
#    权限必须是 root:root 600。

# ── 总开关 ──
# 通知系统默认关闭 (Y8Y_NOTIFY_ENABLED=0)。
# 即使这里打开了, 每个用户还要在「设置 → 通知」里自己开启。
Y8Y_NOTIFY_ENABLED=1

# ── LINE Messaging API ──
# channel access token (Messaging API → 概要 → Messaging API → 渠道 access token)
Y8Y_NOTIFY_LINE_TOKEN=
# 每个用户对应的 LINE user id: <用户id>=<LINE user id>, 逗号分隔
# (用户 id 就是 Y8Y_USERS 里 "邮箱=id" 的那个 id)
# 灰度: 只给一个用户配目标 → 只有他能收到通知。
Y8Y_NOTIFY_LINE_TARGETS=alice=U0000000000000000000000000000000

# ── Email (Resend) ──
# Resend API key
Y8Y_NOTIFY_EMAIL_API_KEY=
# 发件人地址 (Resend 已验证的域名)
Y8Y_NOTIFY_EMAIL_FROM=Y8y Todo <todo@example.com>
# 收件人覆盖 (可选): <用户id>=<邮箱>, 逗号分隔
# 不填时用 Y8Y_USERS 里的邮箱
Y8Y_NOTIFY_EMAIL_TARGETS=

# ── 通知策略 ──
# 通知任务范围:
#   shared         只通知共享任务 (owner=shared) —— 默认值。
#                  私人任务永远不进通知 (连本人自己的也不进)。
#   own_and_shared V1 行为: 本人的 + 共享的。
Y8Y_NOTIFY_TASK_SCOPE=shared
# 收件人白名单 (逗号分隔的用户 id); 留空 = 不额外限制 (谁开了通知且有
# 投递目标, 谁就收)。灰度时写死一个用户 → 发送范围只有他。
Y8Y_NOTIFY_RECIPIENTS=
# 触发窗口 (分钟): 目标时刻之后允许的宽限, 只用来吸收正常调度延迟
# (timer 的 5 分钟轮询 + 一点抖动)。超出它 = 错过, **不补发**。
Y8Y_NOTIFY_WINDOW_MINUTES=10

# ── 行为微调 (可选, 都有合理默认值) ──
# 投递状态保留天数 (超过则清理历史记录)
Y8Y_NOTIFY_RETENTION_DAYS=30
# 调用第三方 API 的超时 (秒)
Y8Y_NOTIFY_TIMEOUT=15

# ⚠️ Y8Y_NOTIFY_CATCHUP_HOURS 已移除: 补发窗口与"错过不补发"的口径
#    冲突。现在没有任何补发配置 —— 错过的时刻永远不补发。

# ── 调试用 (一般不用改) ──
# 调度器启动时会 prctl(PR_SET_DUMPABLE, 0), 让**同 UID** 的其他进程
# (比如被攻破的 Web 服务) 读不到它的 /proc/<pid>/environ —— 凭据因此
# 只留在自己进程里, 不会从 /proc 被顺手拿走。
#
# 代价: 出问题时没有 core dump, 也不能用 gdb 挂上去查。
# 临时需要调试时, 把下面这行的值改成 1 再重启调度器即可 (只影响调度器,
# 不影响 Web 服务); 调试完记得改回 0 或删掉这一行。
#
# 详见 docs/deployment.md §5.2
# Y8Y_NOTIFY_KEEP_DUMPABLE=0
